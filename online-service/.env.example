# Copy to .env and fill in your domain and transactional email configuration.
SERVICE_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TIMEOUT_MS=15000
SMTP_USER=mailer@example.com
MAIL_FROM=Mona <mailer@example.com>

# Passwords and the vault encryption key are files in secrets/, not .env.
LOCAL_API_PORT=18080
CORS_ALLOWED_ORIGINS=
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
SESSION_TTL_DAYS=30
SYNC_INTERVAL_MINUTES=360
WORKER_POLL_MS=2000
JOB_LEASE_SECONDS=120
